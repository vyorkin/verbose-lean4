import Verbose.Russian.All

/-!
# Учебные примеры на русском языке

В отличие от `Examples.lean` (математический анализ: пределы, непрерывность),
здесь используется только элементарная логика и арифметика натуральных чисел.
Примеры идут от самых простых к более сложным и постепенно вводят разные
тактики Verbose Lean, чтобы показать, на что способна библиотека без
привязки к конкретному разделу математики.
-/

open Verbose Russian
open Verbose.Named

set_option linter.unusedTactic false
set_option linter.unusedVariables false

/-! ## Часть 1. Чистая логика -/

-- Извлечение множителя конъюнкции: тактика `По ... получаем ...`
-- разбирает `P ∧ Q` на две отдельные гипотезы.
Пример "Из «P и Q» следует P"
  Дано: (P Q : Prop)
  Предположения: (h : P ∧ Q)
  Заключение: P
Доказательство:
  По h получаем (hP : P) (hQ : Q)
  Заключаем по hP
ЧТД

-- Конъюнкция коммутативна: `Докажем сначала/теперь, что …` разбивает цель
-- вида `_ ∧ _` на две отдельные подцели.
Пример "Конъюнкция коммутативна"
  Дано: (P Q : Prop)
  Предположения: (h : P ∧ Q)
  Заключение: Q ∧ P
Доказательство:
  По h получаем (hP : P) (hQ : Q)
  Докажем сначала, что Q
  Заключаем по hQ
  Докажем теперь, что P
  Заключаем по hP
ЧТД

-- Введение дизъюнкции: `Докажем, что Q` понимает, что раз цель — это
-- `P ∨ Q`, речь идёт о правом варианте, и оставляет цель `Q`.
Пример "Из Q следует «P или Q»"
  Дано: (P Q : Prop)
  Предположения: (h : Q)
  Заключение: P ∨ Q
Доказательство:
  Докажем, что Q
  Заключаем по h
ЧТД

-- Транзитивность импликации: `Предположим` вводит новое предположение,
-- а `Поскольку … заключаем, что …` комбинирует несколько известных фактов.
Пример "Импликация транзитивна"
  Дано: (P Q R : Prop)
  Предположения: (h : P → Q) (h' : Q → R)
  Заключение: P → R
Доказательство:
  Предположим hP : P
  Поскольку P → Q и P получаем, что Q
  Поскольку Q → R и Q заключаем, что R
ЧТД

-- Разбор случаев: `Различаем случаи … или …` доказывает дизъюнкцию (здесь
-- она уже есть среди предположений) и превращает цель в два независимых
-- случая — по одному на каждый вариант.
Пример "Разбор случаев по дизъюнкции"
  Дано: (P Q R : Prop)
  Предположения: (h : P ∨ Q) (hP : P → R) (hQ : Q → R)
  Заключение: R
Доказательство:
  Различаем случаи P или Q
  · Предположим hyp : P
    Заключаем по hP применённый к hyp
  · Предположим hyp : Q
    Заключаем по hQ применённый к hyp
ЧТД

-- Контрапозиция: вместо `P → Q` доказывается равносильное ей `¬Q → ¬P`.
Пример "Доказательство через контрапозицию"
  Дано: (P Q : Prop)
  Предположения: (h : ¬ Q → ¬ P)
  Заключение: P → Q
Доказательство:
  Докажем контрапозицию: ¬ Q → ¬ P
  Заключаем по h
ЧТД

-- Доказательство от противного: `Предположим от противного` заменяет цель
-- `P` на цель `False`, добавляя `¬P` в предположения.
Пример "Снятие двойного отрицания"
  Дано: (P : Prop)
  Предположения: (h : ¬ ¬ P)
  Заключение: P
Доказательство:
  Предположим от противного hnP : ¬ P
  Заключаем по h применённый к hnP
ЧТД

/-! ## Часть 2. Натуральные числа, кванторы и множества -/

-- Свидетель существования: `Докажем, что … подходит` предъявляет
-- конкретное значение квантора существования, а `Вычисляем` закрывает
-- получившееся арифметическое неравенство.
Пример "У каждого числа есть число не меньше него"
  Дано: (n : ℕ)
  Предположения:
  Заключение: ∃ k, n ≤ k
Доказательство:
  Докажем, что n подходит
  Вычисляем
ЧТД

-- Сравнимость любых двух различных чисел: здесь `Различаем случаи`
-- сама доказывает дизъюнкцию `x < y ∨ x > y` (используя, что x ≠ y),
-- а не берёт её из готового предположения, как в примере выше. Для этого
-- нужно подключить соответствующую лемму как «анонимную» — ей затем
-- пользуется сама тактика, без явного упоминания в тексте доказательства.
configureAnonymousCaseSplittingLemmas lt_or_gt_of_ne

Пример "Любые два различных числа сравнимы"
  Дано: (x y : ℕ)
  Предположения: (h : x ≠ y)
  Заключение: x < y ∨ x > y
Доказательство:
  Различаем случаи x < y или x > y
  · Предположим hxy : x < y
    Докажем, что x < y
    Заключаем по hxy
  · Предположим hyx : x > y
    Докажем, что x > y
    Заключаем по hyx
ЧТД

-- Извлечение свидетеля из предположения и вычисление: `По … получаем …
-- такой, что …` достаёт число `k` вместе с уравнением, а `Вычислим` — это
-- калькуляционное доказательство равенства по шагам.
Пример "Удвоенный свидетель чётности"
  Дано: (n : ℕ)
  Предположения: (h : ∃ k, n = 2 * k)
  Заключение: ∃ k, n + n = 2 * k
Доказательство:
  По h получаем k такой, что (H : n = 2 * k)
  Докажем, что 2 * k подходит
  Вычислим n + n = 2 * k + 2 * k из H
  _              = 2 * (2 * k)  вычислением
ЧТД

-- Собственное определение и словарь: как и в `ExampleLib.lean`, можно
-- завести своё понятие и обозначение для него, а затем пользоваться им
-- как встроенным. Здесь — понятие чётности через явного свидетеля.
-- (Имя самого определения должно быть латиницей: кириллица годится для
-- обозначений и текста, но не для идентификаторов Lean.)
def is_even (n : ℕ) := ∃ k, n = 2 * k

notation n " чётно" => is_even n

configureUnfoldableDefs is_even

-- Как и в примерах про пределы, работу с собственным определением начинают
-- с того, что явно расписывают его вручную командой `Докажем, что …`.
Пример "Удвоенное число чётно"
  Дано: (n : ℕ)
  Предположения:
  Заключение: (2 * n) чётно
Доказательство:
  Докажем, что ∃ k, 2 * n = 2 * k
  Докажем, что n подходит
  Вычисляем
ЧТД

-- Более содержательный пример с собственным определением: он сочетает
-- извлечение свидетелей из двух предположений, предъявление нового
-- свидетеля и калькуляционное доказательство.
Пример "Сумма двух чётных чисел чётна"
  Дано: (n m : ℕ)
  Предположения: (hn : n чётно) (hm : m чётно)
  Заключение: (n + m) чётно
Доказательство:
  По hn получаем k такой, что (Hn : n = 2 * k)
  По hm получаем l такой, что (Hm : m = 2 * l)
  Докажем, что ∃ j, n + m = 2 * j
  Докажем, что k + l подходит
  Вычислим n + m = 2 * k + m из Hn
  _              = 2 * k + 2 * l из Hm
  _              = 2 * (k + l)  вычислением
ЧТД

-- То же самое рассуждение работает и для множеств: `По … получаем …`
-- и `Докажем сначала/теперь, что …` не привязаны к арифметике.
Пример "Пересечение множеств симметрично"
  Дано: (s t : Set ℕ) (x : ℕ)
  Предположения: (h : x ∈ s ∩ t)
  Заключение: x ∈ t ∩ s
Доказательство:
  По h получаем (hs : x ∈ s) (ht : x ∈ t)
  Докажем сначала, что x ∈ t
  Заключаем по ht
  Докажем теперь, что x ∈ s
  Заключаем по hs
ЧТД

/-! ## Часть 3. Индукция

Самая продвинутая тактика из показанных здесь — доказательство по
индукции. Формула Гаусса `2 * (0 + 1 + … + n) = n * (n + 1)` — классический
пример, где без индукции не обойтись. -/

/-- Сумма всех натуральных чисел от `0` до `n` включительно. -/
def sum_upto : ℕ → ℕ
  | 0 => 0
  | k + 1 => sum_upto k + (k + 1)

Лемма gauss_sum "Удвоенная сумма первых n натуральных чисел равна n(n+1)"
  Дано: (n : ℕ)
  Предположения:
  Заключение: 2 * sum_upto n = n * (n + 1)
Доказательство:
  Докажем по индукции H : ∀ k, 2 * sum_upto k = k * (k + 1)
  · -- база индукции: n = 0
    Факт h0 : sum_upto 0 = 0 доказательство
      рефл
    Вычислим 2 * sum_upto 0 = 2 * 0       из h0
    _                       = 0 * (0 + 1) вычислением
  · -- шаг индукции: переход от k к k + 1
    Пусть k
    Предположим hyp_rec : 2 * sum_upto k = k * (k + 1)
    Факт hstep : sum_upto (k + 1) = sum_upto k + (k + 1) доказательство
      рефл
    Вычислим 2 * sum_upto (k + 1) = 2 * (sum_upto k + (k + 1)) из hstep
    _                    = 2 * sum_upto k + 2 * (k + 1) вычислением
    _                    = k * (k + 1) + 2 * (k + 1)     из hyp_rec
    _                    = (k + 1) * (k + 1 + 1)          вычислением
ЧТД
